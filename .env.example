# Database Configuration (PostgreSQL)
# For local Docker / direct PostgreSQL instance:
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5532/productivity_dashboard"

# Google Drive Cloud Sync (Optional)
# Create OAuth 2.0 credentials in Google Cloud Console with Google Drive API enabled.
# Authorized redirect URIs:
#   Web/Docker: http://localhost:9999/api/google/callback
#   macOS Desktop: http://127.0.0.1:9898/api/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:9999/api/google/callback"

# AI Assistant Providers (Optional - can also be configured directly via UI settings)
# Gemini API Key (Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=""

# Anthropic Claude API Key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=""

# OpenAI API Key (https://platform.openai.com/)
OPENAI_API_KEY=""
