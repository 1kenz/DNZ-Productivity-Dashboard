generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Todo {
  id              String         @id @default(uuid())
  title           String
  description     String?
  completed       Boolean        @default(false)
  priority        String         @default("medium") // low, medium, high
  projectId       String?
  project         Project?       @relation(fields: [projectId], references: [id])
  tags            String[]
  dueDate         DateTime?
  deadline        DateTime?
  status          String         @default("todo") // kanban column id
  recurringTaskId String?
  recurringTask   RecurringTask? @relation(fields: [recurringTaskId], references: [id])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([recurringTaskId, dueDate])
}

model Project {
  id             String          @id @default(uuid())
  name           String
  color          String
  icon           String?
  todos          Todo[]
  recurringTasks RecurringTask[]
  createdAt      DateTime        @default(now())
}

model KanbanColumn {
  id    String @id @default(uuid())
  name  String
  color String
  order Int
}

model Clock {
  id       String @id @default(uuid())
  city     String
  timezone String
  emoji    String
  order    Int
}

model LinkGroup {
  id    String      @id @default(uuid())
  name  String
  color String
  icon  String?
  links QuickLink[]
  order Int
}

model QuickLink {
  id      String    @id @default(uuid())
  title   String
  url     String
  icon    String?
  groupId String
  group   LinkGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  order   Int
}

model Note {
  id        String   @id @default(uuid())
  title     String
  content   String
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TimeEntry {
  id          String   @id @default(uuid())
  projectId   String // No relation enforced for simplicity, or could add Relation
  taskId      String?
  description String?
  duration    Int // in seconds
  createdAt   DateTime @default(now())
}

model ViewPreferences {
  id            String  @id @default("default") // Singleton row
  taskView      String  @default("list")
  linkView      String  @default("grid")
  showCompleted Boolean @default(true)
  groupBy       String  @default("none")
}

model RecurringTask {
  id          String    @id @default(uuid())
  title       String
  description String?
  priority    String    @default("medium") // low, medium, high
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id])
  tags        String[]
  frequency   String    // "daily" | "weekly" | "monthly"
  interval    Int       @default(1) // every N days / weeks / months
  daysOfWeek  Int[]     @default([]) // 0=Sun .. 6=Sat, used when frequency = "weekly"
  dayOfMonth  Int? // used when frequency = "monthly"
  startDate   DateTime  @default(now())
  endDate     DateTime?
  active      Boolean   @default(true)
  lastRunDate DateTime? // last date through which occurrences were generated
  todos       Todo[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model GoogleDriveAuth {
  id           String   @id @default("default") // Singleton row
  accessToken  String
  refreshToken String
  expiryDate   DateTime
  email        String?
  updatedAt    DateTime @updatedAt
}
