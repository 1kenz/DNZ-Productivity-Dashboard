# Copy this file to desktop/.env (git-ignored) and fill in real values, then
# rebuild with: bash scripts/build_desktop_app.sh
#
# Only needed for Google Drive Sync (Settings → Google Drive Sync). See the
# "Google Drive Sync Setup" section in the project README for how to get
# these from Google Cloud Console.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional — defaults to http://127.0.0.1:9898/api/google/callback if unset.
# Only change this if you also changed SERVER_PORT in desktop/main.js.
# GOOGLE_REDIRECT_URI=http://127.0.0.1:9898/api/google/callback
